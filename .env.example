NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# Optional server-only model override.
GEMINI_MODEL=gemini-3.5-flash-lite
# Server-only; required only for password-verified permanent account deletion.
# Never prefix this key with NEXT_PUBLIC_. Keep it out of browser code and Git.
SUPABASE_SERVICE_ROLE_KEY=
# Set to your HTTPS production origin for SEO, sitemap and social links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional local-only synthetic PDF for the live Gemini smoke check. Never commit bill files.
GEMINI_TEST_BILL_PATH=
